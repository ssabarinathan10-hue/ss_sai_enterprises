# ─────────────────────────────────────────────────────────────
# Express Backend Production Environment Variables
# ─────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# Secret key for JWT token signing (change this to a secure random string)
JWT_SECRET=super_secret_saree_store_jwt_key_prod_2026

# Allowed frontend origin(s) for CORS (set to your Netlify site URL)
CORS_ORIGIN=https://your-saree-store.netlify.app

# Optional: Path to SQLite database if mounted on persistent disk/volume
# DB_PATH=/var/data/saree_store.db

# Optional: Persistent image upload directory
# UPLOADS_DIR=/var/data/uploads
