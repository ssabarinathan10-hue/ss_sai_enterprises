# ─────────────────────────────────────────────────────────────
# SS SAI Enterprises — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.
# ─────────────────────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=5000

# JWT Secret — use a long random string in production
JWT_SECRET=change_me_to_a_long_random_secret_string_at_least_64_chars

# Database path (Render persistent disk: /var/data/saree_store.db)
# Leave empty for local development (uses database/saree_store.db)
DB_PATH=

# Uploads path (Render persistent disk: /var/data/uploads)
# Leave empty for local development (uses frontend/images/uploads)
UPLOADS_PATH=

# CORS — comma-separated list of allowed origins
# In production: your Netlify URL
CORS_ORIGIN=http://localhost:5000,http://localhost:3000

# Admin credentials
ADMIN_EMAIL=vimala@sssai.in
ADMIN_PASSWORD=Admin@123
